{
  "name": "@glz/maintenance",
  "version": "1.0.0",
  "description": "Reporter de errores GLZ — envoltorio fino sobre Sentry apuntando a Bugsink (self-host, soberano UE)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./salud": {
      "types": "./dist/salud.d.ts",
      "default": "./dist/salud.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@sentry/browser": "^10.71.0",
    "@sentry/node": "^10.71.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
